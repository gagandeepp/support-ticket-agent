# Jira
# Personal API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# GitHub
# Personal access token or fine-grained token with repo + pull_request scopes
GITHUB_TOKEN=

# New Relic
# User API key from https://one.newrelic.com/api-keys
NEW_RELIC_API_KEY=

# Azure Application Insights
# API key from your Application Insights resource → Configure → API Access
AZURE_AI_API_KEY=

# AWS CloudWatch Logs (used when observability.cloudwatch.enabled = true)
# Option A — long-lived IAM user credentials (access key + secret)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Option B — temporary session credentials (STS AssumeRole / SSO)
# Set all three; AWS SDK prefers session token when present
AWS_SESSION_TOKEN=

# Knowledgebase — Confluence (used when knowledgebase.platform = "confluence")
# Personal API token from https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=

# Knowledgebase — SharePoint (used when knowledgebase.platform = "sharepoint")
# Azure AD app registration client ID and secret with Sites.Read.All permission
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Metrics — MongoDB push (used when metrics.mongodb.enabled = true)
# The user must have insertOne permission on metrics.mongodb.collection.
# Format: mongodb://user:password@host:27017/?authSource=admin
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
METRICS_MONGODB_URL=

# Database — read-only connection strings (used when database.enabled = true)
# Format per engine:
#   postgres : postgresql://user:password@host:5432/dbname?sslmode=require
#   mysql    : mysql://user:password@host:3306/dbname
#   mssql    : Server=host,1433;Database=db;User Id=user;Password=pass;
#   mongodb  : mongodb://user:password@host:27017/dbname?authSource=admin
# Add one env var per connection defined in database.connections[]
PAYMENTS_DB_READONLY_URL=
USERS_DB_READONLY_URL=
ANALYTICS_DB_READONLY_URL=
EVENTS_DB_READONLY_URL=
